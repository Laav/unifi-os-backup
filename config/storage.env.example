# Copy to /etc/unifi-backup/storage.env, edit as root, then chmod 0600.
# Configure only the backend selected by REMOTE_STORAGE_TYPE in the main file.
# All values below are deliberately fictitious.

# Optional private CA for a self-hosted S3-compatible service.
STORAGE_CA_CERT=""
STORAGE_CONNECT_TIMEOUT="15"
STORAGE_MAX_TIME="1800"

# Azure Blob Storage container URL and a create/write-only SAS. Prefer a user
# delegation SAS. Do not include a blob name; a leading '?' on the token is
# accepted but not required.
AZURE_BLOB_BASE_URL="https://storageaccount.example.invalid/container"
AZURE_BLOB_SAS_TOKEN="CHANGE_ME"
AZURE_BLOB_PREFIX="unifi-os-backups"

# S3 or S3-compatible storage. Path style works with MinIO and many compatible
# services. AWS S3 can use either style, subject to its endpoint requirements.
S3_ENDPOINT="https://s3.example.invalid"
S3_REGION="us-east-1"
S3_BUCKET="unifi-os-backups"
S3_PREFIX="production"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"
S3_SESSION_TOKEN=""
S3_PATH_STYLE="true"
# Optional provider-side encryption request. Supported values are empty,
# AES256, or aws:kms. A KMS key ID is required for aws:kms.
S3_SERVER_SIDE_ENCRYPTION=""
S3_SSE_KMS_KEY_ID=""
