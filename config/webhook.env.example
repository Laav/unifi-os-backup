# Copy to /etc/unifi-backup/webhook.env, edit as root, then chmod 0600.
# All values below are deliberately fictitious.

WEBHOOK_URL="https://monitoring.example.invalid/hooks/unifi-backup"

# Both authentication mechanisms are optional. A Bearer token authenticates
# the request; an HMAC secret lets the receiver verify the exact request body.
WEBHOOK_BEARER_TOKEN=""
WEBHOOK_HMAC_SECRET=""

WEBHOOK_CA_CERT=""
WEBHOOK_CONNECT_TIMEOUT="15"
WEBHOOK_MAX_TIME="60"
