# Copy independently to /etc/unifi-backup/targets.d/NAME.env (root:root 0600).
# Reuse the S3/Azure variables from storage.env.example for cloud targets.
TARGET_TYPE="filesystem"
TARGET_REQUIRED="false"
TARGET_VERIFY="full"
TARGET_IMMUTABILITY="none"
TARGET_LOCK_MODE="locked"
TARGET_LOCK_DAYS="30"
TARGET_ALLOW_PERMANENT_LOCK="false"
STORAGE_CONNECT_TIMEOUT="15"
STORAGE_MAX_TIME="1800"
STORAGE_CA_CERT=""

# The directory must already exist, be root-owned mode 0700, and contain a
# .unifi-backup-target file whose sole contents are this target's identifier.
FILESYSTEM_PATH="/mnt/backup/unifi"
FILESYSTEM_REQUIRE_MOUNT="true"
