# Copy to /etc/unifi-backup/unifi-backup.env, edit as root, then chmod 0600.
# This file contains fictitious placeholders only.
UNIFI_URL="https://unifi.example.invalid:11443"
UNIFI_USERNAME="uni-bck"
UNIFI_PASSWORD="CHANGE_ME"

BACKUP_DIR="/var/backups/unifi"
RETENTION_DAYS="35"
# Zero disables the count limit. The newest RETENTION_MIN_COUNT backups are
# always preserved, even when they exceed the age limit.
RETENTION_COUNT="0"
RETENTION_MIN_COUNT="1"
MIN_BACKUP_SIZE="10000"

CURL_CONNECT_TIMEOUT="15"
CURL_MAX_TIME="1800"
BACKUP_DOWNLOAD_RETRIES="1"
BACKUP_RETRY_DELAY="15"

# For an internal/private CA, install its PEM chain here. Leave empty when the
# UniFi certificate is issued by a CA already trusted by the operating system.
UNIFI_CA_CERT=""

# text preserves the traditional journald output; json emits one compact JSON
# object per event for ingestion by a log platform.
LOG_FORMAT="text"
STATUS_FILE="/var/lib/unifi-backup/status.json"

ENABLE_EMAIL="false"
GRAPH_CONFIG_FILE="/etc/unifi-backup/graph.env"

# none, azure_blob, or s3. Azure Blob is not an S3-compatible protocol; each
# backend has separate settings in storage.env.
REMOTE_STORAGE_TYPE="none"
STORAGE_CONFIG_FILE="/etc/unifi-backup/storage.env"
REMOTE_UPLOAD_REQUIRED="true"

ENABLE_NTFY="false"
NTFY_CONFIG_FILE="/etc/unifi-backup/ntfy.env"
NOTIFY_ON_SUCCESS="false"
NOTIFY_ON_FAILURE="true"
NOTIFY_ON_RECOVERY="true"

# Keep this in the private runtime directory. A lock directly in BACKUP_DIR is
# also accepted for special environments and tests.
LOCK_FILE="/run/unifi-backup/unifi-backup.lock"
