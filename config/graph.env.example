# Copy to /etc/unifi-backup/graph.env, edit as root, then chmod 0600.
# All values below are deliberately fictitious.
TENANT_ID="CHANGE_ME"
CLIENT_ID="CHANGE_ME"
GRAPH_AUTH_METHOD="client_secret"
CLIENT_SECRET="CHANGE_ME"
MAIL_FROM="unifi-backup@example.invalid"
MAIL_TO="operations@example.invalid"

# The simple sendMail JSON route supports only files strictly below 3 MB.
# 2,800,000 leaves headroom for JSON/base64 and message metadata.
GRAPH_SIMPLE_ATTACHMENT_MAX_BYTES="2800000"
