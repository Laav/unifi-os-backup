# Copy to /etc/unifi-backup/ntfy.env, edit as root, then chmod 0600.
# All values below are deliberately fictitious.

NTFY_BASE_URL="https://ntfy.sh"
NTFY_TOPIC="unifi-backup-example-topic"
NTFY_ACCESS_TOKEN="CHANGE_ME"

# Anonymous publishing is disabled by default because a topic name alone is
# not strong access control. Set true only after accepting that risk.
NTFY_ALLOW_ANONYMOUS="false"
NTFY_CA_CERT=""
