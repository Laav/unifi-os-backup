#!/usr/bin/env bash
set -Eeuo pipefail

[[ -n ${MOCK_WEBHOOK_CAPTURE:-} ]] || { echo "mock-webhook-curl: capture directory missing" >&2; exit 64; }
mkdir -p "$MOCK_WEBHOOK_CAPTURE"
count=0
[[ ! -f $MOCK_WEBHOOK_CAPTURE/count ]] || count=$(<"$MOCK_WEBHOOK_CAPTURE/count")
((count+=1))
printf '%s\n' "$count" > "$MOCK_WEBHOOK_CAPTURE/count"
printf '%s\n' "$@" > "$MOCK_WEBHOOK_CAPTURE/argv-$count"
config_file=""
output_file=""
payload_file=""
: > "$MOCK_WEBHOOK_CAPTURE/headers-$count"
while (($#)); do
  case "$1" in
    --config) config_file=$2; shift 2 ;;
    --output) output_file=$2; shift 2 ;;
    --data-binary) [[ $2 == @* ]] || { echo "mock-webhook-curl: payload must be a file" >&2; exit 65; }; payload_file=${2#@}; shift 2 ;;
    --header)
      if [[ $2 == @* ]]; then cat "${2#@}" >> "$MOCK_WEBHOOK_CAPTURE/headers-$count"; else printf '%s\n' "$2" >> "$MOCK_WEBHOOK_CAPTURE/headers-$count"; fi
      shift 2
      ;;
    --write-out|--connect-timeout|--max-time|--request|--cacert) shift 2 ;;
    --silent|--show-error) shift ;;
    *) echo "mock-webhook-curl: unexpected argument: $1" >&2; exit 64 ;;
  esac
done
[[ -f $config_file && -f $payload_file && -n $output_file ]] || { echo "mock-webhook-curl: required argument missing" >&2; exit 65; }
cp "$config_file" "$MOCK_WEBHOOK_CAPTURE/curl-config-$count"
cp "$payload_file" "$MOCK_WEBHOOK_CAPTURE/payload-$count.json"
: > "$output_file"
printf '%s' "${MOCK_WEBHOOK_HTTP_STATUS:-202}"
