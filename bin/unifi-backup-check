#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

CONFIG_FILE="/etc/unifi-backup/unifi-backup.env"
LIVE=false
while (($#)); do
  case "$1" in
    --config) [[ $# -ge 2 ]] || { echo "--config requires a file" >&2; exit 64; }; CONFIG_FILE=$2; shift 2 ;;
    --live) LIVE=true; shift ;;
    -h|--help) echo "Usage: unifi-backup-check [--config FILE] [--live]"; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 64 ;;
  esac
done

backup_bin="/usr/local/sbin/unifi-backup"
[[ -x $backup_bin ]] || backup_bin="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/unifi-backup"
[[ -x $backup_bin ]] || { echo "unifi-backup-check: unifi-backup not found" >&2; exit 69; }

"$backup_bin" --config "$CONFIG_FILE" --validate-config

# Validate the production ownership contract explicitly, even though unprivileged
# development runs may validate a same-user test configuration.
if (( EUID == 0 )); then
  [[ $(stat -c '%u:%g' "$CONFIG_FILE") == "0:0" ]] || { echo "unifi-backup-check: $CONFIG_FILE must be root:root" >&2; exit 78; }
  [[ $(stat -c '%a' "${CONFIG_FILE%/*}") == "700" ]] || { echo "unifi-backup-check: ${CONFIG_FILE%/*} must have mode 0700" >&2; exit 78; }
fi

if [[ $LIVE == "true" ]]; then
  "$backup_bin" --config "$CONFIG_FILE" --check-only
else
  echo "unifi-backup-check: local checks passed (use --live to verify login)"
fi
