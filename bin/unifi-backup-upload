#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

PROGRAM="unifi-backup-upload"
CONFIG_FILE="/etc/unifi-backup/unifi-backup.env"
STORAGE_CONFIG_OVERRIDE=""

usage() {
  echo "Usage: unifi-backup-upload [--config FILE] [--storage-config FILE] FILE"
}

while (($#)); do
  case "$1" in
    --config) [[ $# -ge 2 ]] || { usage >&2; exit 64; }; CONFIG_FILE=$2; shift 2 ;;
    --storage-config) [[ $# -ge 2 ]] || { usage >&2; exit 64; }; STORAGE_CONFIG_OVERRIDE=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --*) echo "$PROGRAM: unknown option: $1" >&2; exit 64 ;;
    *) [[ -z ${UPLOAD_FILE:-} ]] || { usage >&2; exit 64; }; UPLOAD_FILE=$1; shift ;;
  esac
done
: "${UPLOAD_FILE:=}"

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
common_file="$script_dir/../lib/unifi-backup-common.sh"
[[ -r $common_file ]] || common_file="/usr/local/lib/unifi-backup/common.sh"
[[ -r $common_file ]] || { echo "$PROGRAM: ERROR: common library not found" >&2; exit 69; }
# shellcheck source=../lib/unifi-backup-common.sh
# shellcheck disable=SC1091
source "$common_file"

die() { local message=$1 code=${2:-1}; ub_error upload_failed "$message" exit_code "$code"; exit "$code"; }

check_secret_file() {
  local file=$1 mode owner expected=$EUID config_dir dir_mode dir_owner
  [[ $file == /* && -f $file && ! -L $file ]] || die "Invalid configuration file: $file" 78
  mode=$(stat -c '%a' "$file") || die "Cannot inspect $file" 78
  owner=$(stat -c '%u' "$file") || die "Cannot inspect $file owner" 78
  (( EUID == 0 )) && expected=0
  [[ $owner == "$expected" ]] || die "$file must be owned by UID $expected" 78
  (( (8#$mode & 8#077) == 0 )) || die "$file must have no group/other permissions" 78
  config_dir=${file%/*}
  dir_mode=$(stat -c '%a' "$config_dir") || die "Cannot inspect $config_dir" 78
  dir_owner=$(stat -c '%u' "$config_dir") || die "Cannot inspect $config_dir owner" 78
  [[ ! -L $config_dir && $dir_owner == "$expected" ]] || die "Invalid configuration directory: $config_dir" 78
  (( (8#$dir_mode & 8#077) == 0 )) || die "$config_dir must have no group/other permissions" 78
}

for command_name in curl python3 sha256sum stat mktemp; do
  command -v "$command_name" >/dev/null 2>&1 || die "Required command not found: $command_name" 69
done
check_secret_file "$CONFIG_FILE"
# shellcheck disable=SC1090
source "$CONFIG_FILE"
: "${LOG_FORMAT:=text}" "${REMOTE_STORAGE_TYPE:=none}"
: "${STORAGE_CONFIG_FILE:=/etc/unifi-backup/storage.env}" "${BACKUP_DIR:=/var/backups/unifi}"
STORAGE_CONFIG_FILE=${STORAGE_CONFIG_OVERRIDE:-$STORAGE_CONFIG_FILE}
[[ $LOG_FORMAT == "text" || $LOG_FORMAT == "json" ]] || die "LOG_FORMAT must be text or json" 78
[[ $REMOTE_STORAGE_TYPE == "azure_blob" || $REMOTE_STORAGE_TYPE == "s3" ]] || die "REMOTE_STORAGE_TYPE must be azure_blob or s3 for upload" 78
check_secret_file "$STORAGE_CONFIG_FILE"
# shellcheck disable=SC1090
source "$STORAGE_CONFIG_FILE"

: "${STORAGE_CA_CERT:=}" "${STORAGE_CONNECT_TIMEOUT:=15}" "${STORAGE_MAX_TIME:=1800}"
: "${AZURE_BLOB_BASE_URL:=}" "${AZURE_BLOB_SAS_TOKEN:=}" "${AZURE_BLOB_PREFIX:=}"
: "${S3_ENDPOINT:=}" "${S3_REGION:=}" "${S3_BUCKET:=}" "${S3_PREFIX:=}"
: "${S3_ACCESS_KEY_ID:=}" "${S3_SECRET_ACCESS_KEY:=}" "${S3_SESSION_TOKEN:=}"
: "${S3_PATH_STYLE:=true}"
: "${S3_SERVER_SIDE_ENCRYPTION:=}" "${S3_SSE_KMS_KEY_ID:=}"

ub_is_positive_int "$STORAGE_CONNECT_TIMEOUT" || die "STORAGE_CONNECT_TIMEOUT must be a positive integer" 78
ub_is_positive_int "$STORAGE_MAX_TIME" || die "STORAGE_MAX_TIME must be a positive integer" 78
(( STORAGE_MAX_TIME >= STORAGE_CONNECT_TIMEOUT )) || die "STORAGE_MAX_TIME must be at least STORAGE_CONNECT_TIMEOUT" 78
[[ -z $STORAGE_CA_CERT || ( $STORAGE_CA_CERT == /* && -f $STORAGE_CA_CERT && -r $STORAGE_CA_CERT ) ]] || die "STORAGE_CA_CERT must be a readable absolute file" 78
BACKUP_DIR=${BACKUP_DIR%/}
[[ $UPLOAD_FILE == /* && ${UPLOAD_FILE%/*} == "$BACKUP_DIR" ]] || die "Upload file must be directly inside BACKUP_DIR" 66
[[ -f $UPLOAD_FILE && -r $UPLOAD_FILE && -s $UPLOAD_FILE && ! -L $UPLOAD_FILE ]] || die "Upload file is missing, empty, unreadable, or a symbolic link" 66
[[ ${UPLOAD_FILE##*/} =~ ^unifi_os_backup_[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}\.unifi(\.json)?$ ]] || die "Upload filename does not match a managed backup or metadata filename" 65

tmp_response=$(mktemp "${TMPDIR:-/tmp}/unifi-storage-response.XXXXXX")
tmp_headers=$(mktemp "${TMPDIR:-/tmp}/unifi-storage-headers.XXXXXX")
tmp_curl_config=$(mktemp "${TMPDIR:-/tmp}/unifi-storage-curl.XXXXXX")
tmp_secret_input=$(mktemp "${TMPDIR:-/tmp}/unifi-storage-secret.XXXXXX")
cleanup() { local rc=$?; rm -f -- "$tmp_response" "$tmp_headers" "$tmp_curl_config" "$tmp_secret_input"; exit "$rc"; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

file_sha256=$(sha256sum "$UPLOAD_FILE" | awk '{print $1}')
file_name=${UPLOAD_FILE##*/}
content_type="application/octet-stream"
[[ $file_name == *.json ]] && content_type="application/json"
curl_args=(--silent --show-error --connect-timeout "$STORAGE_CONNECT_TIMEOUT" --max-time "$STORAGE_MAX_TIME"
  --request PUT --upload-file "$UPLOAD_FILE" --output "$tmp_response" --write-out '%{http_code}')
[[ -n $STORAGE_CA_CERT ]] && curl_args+=(--cacert "$STORAGE_CA_CERT")

if [[ $REMOTE_STORAGE_TYPE == "azure_blob" ]]; then
  [[ $AZURE_BLOB_BASE_URL =~ ^https://[^/?#@[:space:]]+/[^/?#[:space:]]+$ ]] || die "AZURE_BLOB_BASE_URL must be an HTTPS container URL without credentials or query" 78
  [[ -n $AZURE_BLOB_SAS_TOKEN && $AZURE_BLOB_SAS_TOKEN != "CHANGE_ME" ]] || die "AZURE_BLOB_SAS_TOKEN is required" 78
  [[ $AZURE_BLOB_SAS_TOKEN != *$'\n'* && $AZURE_BLOB_SAS_TOKEN != *$'\r'* ]] || die "AZURE_BLOB_SAS_TOKEN contains a newline" 78
  [[ $AZURE_BLOB_PREFIX != /* && $AZURE_BLOB_PREFIX != *".."* ]] || die "AZURE_BLOB_PREFIX must be a safe relative prefix" 78

  printf '%s\0%s' "$AZURE_BLOB_SAS_TOKEN" "$file_name" > "$tmp_secret_input"
  python3 - "$AZURE_BLOB_BASE_URL" "$AZURE_BLOB_PREFIX" "$tmp_curl_config" "$tmp_secret_input" <<'PY'
import sys, urllib.parse

base, prefix, output, secret_file = sys.argv[1:]
secret, name = open(secret_file, "rb").read().split(b"\0", 1)
secret = secret.decode()
name = name.decode()
parts = [part for part in prefix.split("/") if part] + [name]
path = "/".join(urllib.parse.quote(part, safe="-_.~") for part in parts)
url = base.rstrip("/") + "/" + path + "?" + secret.lstrip("?")
url = url.replace("\\", "\\\\").replace('"', '\\"')
with open(output, "w", encoding="utf-8") as stream:
    stream.write(f'url = "{url}"\n')
PY
  chmod 0600 "$tmp_curl_config"
  curl_args+=(--config "$tmp_curl_config" --header 'x-ms-version: 2023-11-03'
    --header 'x-ms-blob-type: BlockBlob' --header "x-ms-blob-content-type: $content_type"
    --header "x-ms-meta-sha256: $file_sha256" --header 'If-None-Match: *')
  ub_info remote_upload_started "Uploading file to Azure Blob Storage" backend azure_blob file "$file_name"
  if http_status=$(curl "${curl_args[@]}"); then :; else
    rc=$?; die "Azure Blob transport failure: $(ub_describe_curl_error "$rc")" 69
  fi
  [[ $http_status == "201" ]] || {
    error_code=$(python3 - "$tmp_response" <<'PY'
import re, sys
data=open(sys.argv[1], "rb").read(32768).decode("utf-8", "replace")
match=re.search(r"<Code>([^<]{1,100})</Code>", data)
print(match.group(1) if match else "request_rejected")
PY
    )
    die "Azure Blob upload failed: HTTP $http_status ($error_code)" 75
  }
else
  [[ $S3_ENDPOINT =~ ^https://[^/?#@[:space:]]+$ ]] || die "S3_ENDPOINT must be an HTTPS origin without credentials, path, or query" 78
  [[ $S3_REGION =~ ^[A-Za-z0-9-]+$ ]] || die "S3_REGION is invalid" 78
  [[ $S3_BUCKET =~ ^[A-Za-z0-9][A-Za-z0-9._-]{1,61}[A-Za-z0-9]$ ]] || die "S3_BUCKET is invalid" 78
  [[ $S3_PREFIX != /* && $S3_PREFIX != *".."* ]] || die "S3_PREFIX must be a safe relative prefix" 78
  [[ -n $S3_ACCESS_KEY_ID && $S3_ACCESS_KEY_ID != "CHANGE_ME" ]] || die "S3_ACCESS_KEY_ID is required" 78
  [[ -n $S3_SECRET_ACCESS_KEY && $S3_SECRET_ACCESS_KEY != "CHANGE_ME" ]] || die "S3_SECRET_ACCESS_KEY is required" 78
  ub_is_bool "$S3_PATH_STYLE" || die "S3_PATH_STYLE must be true or false" 78
  [[ -z $S3_SERVER_SIDE_ENCRYPTION || $S3_SERVER_SIDE_ENCRYPTION == "AES256" || $S3_SERVER_SIDE_ENCRYPTION == "aws:kms" ]] || die "S3_SERVER_SIDE_ENCRYPTION must be empty, AES256, or aws:kms" 78
  [[ $S3_SERVER_SIDE_ENCRYPTION != "aws:kms" || -n $S3_SSE_KMS_KEY_ID ]] || die "S3_SSE_KMS_KEY_ID is required for aws:kms" 78

  printf '%s\0%s\0%s' "$S3_ACCESS_KEY_ID" "$S3_SECRET_ACCESS_KEY" "$S3_SESSION_TOKEN" > "$tmp_secret_input"
  python3 - "$S3_ENDPOINT" "$S3_REGION" "$S3_BUCKET" "$S3_PREFIX" "$file_name" "$file_sha256" "$S3_PATH_STYLE" "$S3_SERVER_SIDE_ENCRYPTION" "$S3_SSE_KMS_KEY_ID" "$tmp_headers" "$tmp_curl_config" "$tmp_secret_input" <<'PY'
import datetime, hashlib, hmac, sys, urllib.parse

endpoint, region, bucket, prefix, name, payload_hash, path_style, encryption, kms_key, headers_out, curl_out, secret_file = sys.argv[1:]
access, secret, session = (item.decode() for item in open(secret_file, "rb").read().split(b"\0", 2))
parsed = urllib.parse.urlsplit(endpoint)
segments = [part for part in prefix.split("/") if part] + [name]
key = "/".join(urllib.parse.quote(part, safe="-_.~") for part in segments)
if path_style == "true":
    canonical_uri = "/" + urllib.parse.quote(bucket, safe="-_.~") + "/" + key
    host = parsed.netloc
else:
    canonical_uri = "/" + key
    host = bucket + "." + parsed.netloc
url = f"{parsed.scheme}://{host}{canonical_uri}"
now = datetime.datetime.now(datetime.timezone.utc)
amz_date = now.strftime("%Y%m%dT%H%M%SZ")
date_stamp = now.strftime("%Y%m%d")
headers = {"host": host, "x-amz-content-sha256": payload_hash, "x-amz-date": amz_date}
headers["x-amz-meta-sha256"] = payload_hash
if session:
    headers["x-amz-security-token"] = session
if encryption:
    headers["x-amz-server-side-encryption"] = encryption
if kms_key:
    headers["x-amz-server-side-encryption-aws-kms-key-id"] = kms_key
signed_headers = ";".join(sorted(headers))
canonical_headers = "".join(f"{key}:{headers[key].strip()}\n" for key in sorted(headers))
canonical_request = "\n".join(["PUT", canonical_uri, "", canonical_headers, signed_headers, payload_hash])
scope = f"{date_stamp}/{region}/s3/aws4_request"
string_to_sign = "\n".join(["AWS4-HMAC-SHA256", amz_date, scope, hashlib.sha256(canonical_request.encode()).hexdigest()])
def sign(key, value):
    return hmac.new(key, value.encode(), hashlib.sha256).digest()
k_date = sign(("AWS4" + secret).encode(), date_stamp)
k_region = sign(k_date, region)
k_service = sign(k_region, "s3")
k_signing = sign(k_service, "aws4_request")
signature = hmac.new(k_signing, string_to_sign.encode(), hashlib.sha256).hexdigest()
authorization = f"AWS4-HMAC-SHA256 Credential={access}/{scope}, SignedHeaders={signed_headers}, Signature={signature}"
with open(headers_out, "w", encoding="utf-8") as stream:
    stream.write("Authorization: " + authorization + "\n")
    stream.write("x-amz-content-sha256: " + payload_hash + "\n")
    stream.write("x-amz-date: " + amz_date + "\n")
    stream.write("x-amz-meta-sha256: " + payload_hash + "\n")
    if session:
        stream.write("x-amz-security-token: " + session + "\n")
    if encryption:
        stream.write("x-amz-server-side-encryption: " + encryption + "\n")
    if kms_key:
        stream.write("x-amz-server-side-encryption-aws-kms-key-id: " + kms_key + "\n")
escaped = url.replace("\\", "\\\\").replace('"', '\\"')
with open(curl_out, "w", encoding="utf-8") as stream:
    stream.write(f'url = "{escaped}"\n')
PY
  chmod 0600 "$tmp_headers" "$tmp_curl_config"
  curl_args+=(--config "$tmp_curl_config" --header "@$tmp_headers" --header "Content-Type: $content_type" --header 'If-None-Match: *')
  ub_info remote_upload_started "Uploading file to S3-compatible storage" backend s3 file "$file_name"
  if http_status=$(curl "${curl_args[@]}"); then :; else
    rc=$?; die "S3 transport failure: $(ub_describe_curl_error "$rc")" 69
  fi
  [[ $http_status == "200" ]] || {
    error_code=$(python3 - "$tmp_response" <<'PY'
import re, sys
data=open(sys.argv[1], "rb").read(32768).decode("utf-8", "replace")
match=re.search(r"<Code>([^<]{1,100})</Code>", data)
print(match.group(1) if match else "request_rejected")
PY
    )
    die "S3 upload failed: HTTP $http_status ($error_code)" 75
  }
fi

ub_info remote_upload_succeeded "Remote upload completed" backend "$REMOTE_STORAGE_TYPE" file "$file_name" size_bytes "$(stat -c '%s' "$UPLOAD_FILE")"
